    place_row(b, "J4", 44, 57, ["VBAT", "GND"], "ESC (XT30 lead)", height=10.0)
    place_row(b, "J2", 30, 57, ["SCL", "SDA", "GND"], "I²C to A J2", jst=True)
    place_row(b, "J5", 44, 16, ["+5V", "GND", "+3V3_A", "GND"], "PWR to A J1", direction="down", jst=True)
    place_row(b, "J6", 41, 16, ["+5V", "GND", "+3V3_B", "GND"], "PWR to B J1", direction="down", jst=True)
    place_row(b, "J7", 38, 16, ["+5V", "GND", "+3V3_B", "GND"], "PWR to D J8", direction="down", jst=True)
    place_row(b, "J8", 35, 16, ["+8V", "+8V", "GND", "GND"], "8 V → PARACHUTE J1", direction="down", jst=True)
    place_row(b, "J9", 35, 9, ["+5VS", "GND"], "5 V servo → PARACHUTE J6", direction="down", jst=True)
    place_row(b, "J10", 44, 9, ["VBAT", "GND"], "VBAT sense to A J3", direction="down", jst=True)
    place_2pin(b, "C1", 22, 44, 24, 44, "470µF 25V VBAT", kind="CP")
    b.nets = [
        Net("SCL", [("J2", "1"), ("U1", "3"), ("U2", "3"), ("U3", "3")]),
        Net("SDA", [("J2", "2"), ("U1", "4"), ("U2", "4"), ("U3", "4")]),
        Net("GND", [("J1", "2"), ("U1", "2"), ("U2", "2"), ("U3", "2"), ("M1L", "2"), ("M2L", "2"), ("M3L", "2"),
                    ("M4L", "2"), ("M5L", "2"), ("D1", "2"), ("J4", "2"), ("J2", "3"), ("J5", "2"), ("J5", "4"),
                    ("J6", "2"), ("J6", "4"), ("J7", "2"), ("J7", "4"), ("J8", "3"), ("J8", "4"), ("J9", "2"), ("J10", "2"),
                    ("C1", "2")], kind="wire"),
        Net("BAT+", [("J1", "1"), ("J3", "1")], kind="wire"),
        Net("VBAT_SW", [("J3", "2"), ("F1", "1"), ("R1", "1")], kind="wire"),
        Net("VBAT_F", [("F1", "2"), ("U1", "7")], kind="wire"),
        Net("VBAT", [("U1", "8"), ("U1", "6"), ("M1L", "1"), ("M2L", "1"), ("M3L", "1"), ("J4", "1"), ("J10", "1"),
                     ("C1", "1")], kind="wire"),
        Net("LED_A", [("R1", "2"), ("D1", "1")]),
        Net("8V_RAW", [("M3L", "3"), ("U2", "7")], kind="wire"),
        Net("+8V_STEER", [("U2", "8"), ("U2", "6"), ("J8", "1"), ("J8", "2")], kind="wire"),
        Net("5V_RAW", [("M1L", "3"), ("U3", "7")], kind="wire"),
        Net("+5V_LOGIC", [("U3", "8"), ("U3", "6"), ("J5", "1"), ("J6", "1"), ("J7", "1"),
                          ("M4L", "1"), ("M5L", "1")], kind="wire"),
        Net("+5V_SERVO", [("M2L", "3"), ("J9", "1")], kind="wire"),
        Net("+3V3_A", [("M4L", "3"), ("J5", "3"), ("U1", "1"), ("U2", "1"), ("U3", "1")], kind="wire"),
        Net("+3V3_B", [("M5L", "3"), ("J6", "3"), ("J7", "3")], kind="wire"),
    ]
    return b


BOARDS = {"A": (board_a, [("U1", EXPECT_A, FORBIDDEN_A)]),
          "B": (board_b, [("U1", EXPECT_B, FORBIDDEN_B)]),
          "D": (board_d, [("U1", EXPECT_D, FORBIDDEN_D)]),
          "E": (board_e, [])}


def run(key: str) -> bool:
    make, pin_checks = BOARDS[key]
    b = make()
    problems = fit_check(b)
    for ref, exp, forb in pin_checks:
        problems += check_pins(b, ref, exp, forb)
    results, occ = route(b)
    problems += verify(b, results, occ)
    jumpers = sum(len(r["jumpers"]) for r in results.values() if not r.get("wire"))
    holes = sum(len(set(h for p in r["segs"] for h in p)) for r in results.values())
    print(f"[{key}] nets={len(b.nets)} routed-holes={holes} top-jumpers={jumpers} problems={len(problems)}")
    for m in problems:
        print("   !", m)
    render_top(b, results, os.path.join(OUT, f"{key}_top.png"))
    render_bottom(b, results, os.path.join(OUT, f"{key}_bottom.png"))
    with open(os.path.join(OUT, f"{key}_wiring.md"), "w", encoding="utf-8") as f:
        f.write(wiring_list(b, results))
    return not problems


if __name__ == "__main__":
    keys = sys.argv[1:] or list(BOARDS)
    ok = all([run(k) for k in keys])
    sys.exit(0 if ok else 1)
