# ===========================================================================
# BOARD D — PARAFOIL / RECOVERY Teensy 4.0
# ===========================================================================
T40_PIN = lambda n: str(n + 2)          # Teensy 4.0 pin n -> footprint pad


def _cp(b, ref, c1, r1, c2, r2, label, dia=10.0):
    """Radial electrolytic standing up: real round body (Ø dia) instead of the pad box."""
    p = place_2pin(b, ref, c1, r1, c2, r2, label, kind="CP")
    xc, yc = (hx(c1) + hx(c2)) / 2, (hy(r1) + hy(r2)) / 2
    p.body = (xc - dia / 2, yc - dia / 2, xc + dia / 2, yc + dia / 2)
    return p


def board_d() -> Board:
    """Board 4 PARACHUTE — ROUND Ø110 mm zero board (user), parts packed for short trails."""
    _z.set_board(110.0, 110.0)                       # 43 x 43 holes, hole C22 R22 = disk centre
    b = Board("D", "Board 4 PARACHUTE (Teensy 4.0) — Ø110 round zero board", keep_x=(0.0, 110.0), plane_y=None)
    b.round = (55.0, 55.0, 55.0)
    # 4 rods Ø8.2 on the 94 mm circle, turned 22.5° on this board so they miss the Teensy and the servo row
    b.rods = [(55.0 + 47.0 * math.cos(math.radians(a)), 55.0 + 47.0 * math.sin(math.radians(a)), 8.2)
              for a in (22.5, 112.5, 202.5, 292.5)]
    b.notes = ["Servo plugs: − + S, S toward the Teensy. Servo power (8 V, 5 V) trails: lay ≥20 AWG wire along them. "
               "Hall output pulled up to 3.3 V only."]
    place_fp(b, "U1", "Teensy_4.0_hdr_Robu", "1", 20, 39, 270, "Teensy 4.0 PARACHUTE", T40_NAMES, 13.0, C_MCU,
             note="female headers · USB toward the edge", pins_used={str(i) for i in range(1, 29)})
    # LEFT: servo headers (2.54 mm, − + S on columns 6/7/8), 330 Ω straight from S toward the Teensy
    servos = (("J10", "A20CLM LEFT steer (8 V)", "R1"), ("J11", "A20CLM RIGHT steer (8 V)", "R2"),
              ("J12", "MG90S #1 PARACHUTE BAY", "R3"), ("J13", "MG90S #2 PETRI PLATE", "R4"),
              ("J16", "MG90S #3 EXTRA", "R9"))
    for i, (ref, name, rref) in enumerate(servos):
        row = 31 - 2 * i
        place_row(b, ref, 6, row, ["−", "+", "S"], name, height=14.0, note="2.54 mm servo header")
        place_2pin(b, rref, 13, row, 9, row, "330")
    # 8 V in right above the steering servos; 5 V servo in right below the MG90S
    place_row(b, "J1", 12, 33, ["+8V", "+8V", "GND", "GND"], "8 V steer in (POWER J8)", direction="left", jst=True)
    _cp(b, "C1", 11, 36, 9, 36, "470µF 8V rail")       # + over the +8V pins, − over GND
    place_row(b, "J6", 7, 20, ["+5VS", "GND"], "5 V servo in (POWER J9)", direction="left", jst=True)
    _cp(b, "C2", 10, 20, 12, 20, "470µF 5VS rail")
    # RIGHT: logic power by VIN, BMP585 on the I²C pins, ICM-20948 under it
    place_row(b, "J8", 29, 38, ["+5V", "GND", "+3V3", "GND"], "logic PWR (POWER J7)", jst=True)
    _cp(b, "C3", 35, 34, 37, 34, "470µF logic")
    place_2pin(b, "C4", 27, 39, 27, 37, "100nF", kind="C")    # right at VIN / GND of the Teensy
    place_fp(b, "U5", "BMP585_hdr8", "1", 28, 35, 270, "BMP585 #3", BMP, 6.0, C_SENS, note="0x47 · own 600 m baro")
    place_fp(b, "U6", "ICM20948_7Semi_hdr12", "1", 28, 25, 270, "ICM-20948 #2", ICM, 6.0, C_SENS,
             note="CS+SDO → 1V8 · 0x69")
    place_2pin(b, "C5", 35, 29, 35, 31, "100nF", kind="C")
    # BOTTOM: plugs in the same left-to-right order as the Teensy pins that reach them under the Teensy
    place_row(b, "J15", 31, 12, ["−", "+5V", "OUT"], "HALL sensor", jst=True)
    place_2pin(b, "R6", 35, 12, 35, 16, "10k HALL↑3V3")
    place_row(b, "J2", 22, 16, ["TX2→A", "RX2←A", "GND"], "UART from MAIN J4", jst=True)
    place_2pin(b, "R7", 22, 23, 22, 19, "1k TX2→A")
    place_row(b, "J14", 27, 16, ["−", "S"], "ESC signal (Cyclone 45A BLHeli_S)", jst=True)
    place_2pin(b, "R5", 26, 23, 26, 19, "330")
    place_row(b, "J5", 31, 16, ["GNSS", "GND"], "GNSS from MAIN J8", jst=True)
    place_row(b, "J3", 37, 23, ["TX→B", "RX3←B", "GND"], "UART to BACKUP J3", direction="up", jst=True)
    place_2pin(b, "R8", 37, 17, 37, 21, "1k TX→B")
    T = lambda n: ("U1", T40_PIN(n))
    b.nets = [
        Net("GND", [("U1", "1"), ("U1", "27"), ("U5", "3"), ("U6", "3"), ("U6", "9"), ("U6", "12"),
                    ("J10", "1"), ("J11", "1"), ("J12", "1"), ("J13", "1"), ("J16", "1"), ("J14", "1"), ("J15", "1"), ("J2", "3"),
                    ("J5", "2"), ("J3", "3"), ("J1", "3"), ("J1", "4"), ("J6", "2"), ("J8", "2"), ("J8", "4"), ("C1", "2"),
                    ("C2", "2"), ("C3", "2"), ("C4", "2"), ("C5", "2")], kind="wire"),
        Net("+8V_STEER", [("J1", "1"), ("J1", "2"), ("C1", "1"), ("J10", "2"), ("J11", "2")], kind="wire"),
        Net("+5V_SERVO", [("J6", "1"), ("C2", "1"), ("J12", "2"), ("J13", "2"), ("J16", "2")], kind="wire"),
        Net("+5V_LOGIC", [("J8", "1"), ("U1", "28"), ("C3", "1"), ("C4", "1"), ("J15", "2")], kind="wire"),
        Net("+3V3_B", [("J8", "3"), ("U5", "1"), ("U5", "5"), ("U5", "7"), ("U6", "1"), ("R6", "2"), ("C5", "1")],
            kind="wire"),
        Net("ICM_1V8", [("U6", "2"), ("U6", "7"), ("U6", "8")]),
        Net("SDA", [T(18), ("U5", "6"), ("U6", "5")]),
        Net("SCL", [T(19), ("U5", "4"), ("U6", "4")]),
        Net("GNSS_IN", [("J5", "1"), T(0)]),
        Net("STEER_L", [T(2), ("R1", "1")]), Net("STEER_L_S", [("R1", "2"), ("J10", "3")]),
        Net("STEER_R", [T(3), ("R2", "1")]), Net("STEER_R_S", [("R2", "2"), ("J11", "3")]),
        Net("BAY_LID", [T(4), ("R3", "1")]), Net("BAY_LID_S", [("R3", "2"), ("J12", "3")]),
        Net("PETRI", [T(5), ("R4", "1")]), Net("PETRI_S", [("R4", "2"), ("J13", "3")]),
        Net("SERVO_X", [T(10), ("R9", "1")]), Net("SERVO_X_S", [("R9", "2"), ("J16", "3")]),
        Net("ESC", [T(6), ("R5", "1")]), Net("ESC_S", [("R5", "2"), ("J14", "2")]),
        Net("RX2", [("J2", "2"), T(7)]),
        Net("TX2", [T(8), ("R7", "1"), ("R8", "1")]),
        Net("TX2_A", [("R7", "2"), ("J2", "1")]),
        Net("TX2_B", [("R8", "2"), ("J3", "1")]),
        Net("RX3", [("J3", "2"), T(15)]),
        Net("HALL", [T(9), ("J15", "3"), ("R6", "1")]),
    ]
    return b


