"""Board definitions for the VRITRA zero-board build (pin map v0.2, see
../03_PIN_MAP_AND_WIRING.md). Run:  python boards.py  [A B C D E]
Outputs per board: <key>_top.png, <key>_bottom.png, <key>_wiring.md
"""
from __future__ import annotations

import os
import sys

import math

import zb_engine as _z
from zb_engine import (Board, Net, fit_check, hx, hy, place_2pin, place_box, place_fp, place_row,
                       render_bottom, render_top, route, verify, wiring_list)

OUT = os.path.dirname(os.path.abspath(__file__))

C_MCU, C_RF, C_SENS, C_PWR = "#f6c85f", "#9fd3f5", "#b8e0a6", "#f4a582"

T41_NAMES = {str(i): str(i) for i in range(42)}
T41_NAMES.update({"GND1": "GND", "GND2": "GND", "GND3": "GND", "3V3_1": "3V3", "3V3_2": "3V3", "VIN": "VIN"})
T40_NAMES = {"1": "GND", "28": "VIN", "27": "GND", "26": "3V3"}
T40_NAMES.update({str(i + 2): str(i) for i in range(24)})      # symbol pins 2..25 = Teensy 0..23
CORE = {"1": "2.4G", "2": "GND", "3": "CS", "4": "CLK", "5": "MOSI", "6": "MISO", "7": "RESET", "8": "BUSY",
        "9": "LORA_ANT", "10": "GND", "11": "DIO9", "12": "DIO8", "13": "DIO7", "14": "NC", "15": "GND", "16": "3.3V"}
L89 = {"1": "3D_FIX", "2": "WAKE", "3": "SDA", "4": "SCL", "5": "GEO", "6": "JAM", "7": "RST", "8": "BAT",
       "9": "TX", "10": "RX", "11": "3V3", "12": "GND"}
BMP = {"1": "VIN", "2": "3V3", "3": "GND", "4": "SCK", "5": "SDO", "6": "SDI", "7": "CS", "8": "INT"}
ICM = {"1": "VIN", "2": "1V8", "3": "GND", "4": "SCL", "5": "SDA", "6": "INT", "7": "CS", "8": "SDO", "9": "GND",
       "10": "ACL", "11": "ADA", "12": "FSYNC"}
W25 = {"1": "3V3", "2": "CS", "3": "MISO", "4": "SCK", "5": "MOSI", "6": "GND"}
LSM = {"1": "VIN", "2": "3Vo", "3": "GND", "4": "SCL", "5": "SDA", "6": "DO", "7": "CS", "8": "INT1", "9": "INT2",
       "10": "SCX", "11": "SDX", "12": "CS(back)", "13": "DO(back)", "14": "GND(back)"}   # 9 front + 5 back = 14 holes
MUX = {"1": "VCC_L1", "2": "TX1", "3": "RX1", "4": "GND", "5": "VCC_L2", "6": "TX2", "7": "RX2", "8": "GND",
       "9": "A", "10": "B", "11": "VCC_R1", "12": "TX3", "13": "RX3", "14": "GND", "15": "VCC_R2", "16": "TX4",
       "17": "RX4", "18": "GND", "19": "C", "20": "GND"}   # from the KiCad symbol (BO-10145)
AMP = {"1": "LRC", "2": "BCLK", "3": "DIN", "4": "GAIN", "5": "SD", "6": "GND", "7": "Vin"}  # Adafruit #3006 order
INA = {"1": "VCC", "2": "GND", "3": "SCL", "4": "SDA", "5": "ALERT", "6": "VBUS", "7": "IN+", "8": "IN-"}


def ds3231_flat(b, ref, c, r_top):
    """ZS-042 'MH' RTC mounted FLAT on a straight 4-pin header through its
    4-hole end (SCL, SDA, VCC, GND top to bottom). Body 38 x 22 mm extends to
    the right of the pin column; CR2032 faces up. 6-pin right-angle end unused."""
    p = place_row(b, ref, c, r_top, ["SCL", "SDA", "VCC", "GND"], "DS3231 (MH ZS-042)", direction="down",
                  height=9.5, color=C_SENS,
                  note="flat on 4-pin end · CR2032 up\nREMOVE charge resistor · 0x68 + EEPROM 0x57")
    yc = (hy(r_top) + hy(r_top - 3)) / 2
    p.body = (hx(c) - 2.0, yc - 11.0, hx(c) + 36.0, yc + 11.0)
    return p


# ===========================================================================
# BOARD A — PRIMARY (follows firmware vritra_fc/Config.h rev 2026-08)
# ===========================================================================
def board_a() -> Board:
    b = Board("A", "Board A PRIMARY (Teensy 4.1 #1)", keep_x=(0.0, 120.0), plane_y=None)
    b.notes = ["Do NOT connect the Teensy 3V3 pins to the 3V3_A rail. Teensy pins 33-36 are still driven by the "
               "firmware (old motor driver) - leave them free. 3 mm edges kept clear for the slot mount."]
    # Teensy upright, USB at the TOP, microSD at the BOTTOM (rot 270: pad 0 at C21 R40)
    place_fp(b, "U1", "Teensy 4.1_hdr", "0", 21, 40, 270, "Teensy 4.1 PRIMARY", T41_NAMES, 13.0, C_MCU,
             note="on female headers\nUSB up · microSD down")
    # left side: radio (SPI1 pins 24-30 are on the left column) and GNSS (Serial2 pins 6-8)
    place_fp(b, "U2", "Core1121xf Lora", "8", 8, 12, 90, "Core1121-HF", CORE, 6.0, C_RF,
             note="label side DOWN\nu.FL → T-antenna")
    place_fp(b, "U3", "L89_hdr", "1", 9, 55, 90, "L89HA GNSS", L89, 10.0, C_RF,
             note="7Semi board · built-in antennas\n9600 baud")
    # right side, all ABOVE the Serial3/Wire1 rows so the I2C bus never crosses them
    p = place_row(b, "U4", 32, 56, ["SCL", "SDA", "VCC", "GND"], "DS3231 (MH ZS-042)", direction="right",
                  height=9.5, color=C_SENS, note="flat on its 4-pin end · CR2032 up\nREMOVE charge resistor\n0x68 + EEPROM 0x57")
    xc = (hx(32) + hx(35)) / 2
    p.body = (xc - 11.0, hy(56) - 36.0, xc + 11.0, hy(56) + 2.0)
    place_fp(b, "U5", "BMP585_hdr8", "1", 31, 36, 0, "BMP585 #1", BMP, 6.0, C_SENS, note="0x47 (SDO→3V3)")
    place_fp(b, "U6", "ICM20948_7Semi_hdr12", "1", 40, 45, 0, "ICM-20948 #1", ICM, 6.0, C_SENS,
             note="CS+SDO → 1V8 · 0x69")
    # left side, under the radio: SPI flash shares SPI1 (26/27/39) with the Core1121
    place_fp(b, "U7", "W25Q64_hdr6", "1", 14, 9, 180, "W25Q64 flash", W25, 6.0, C_SENS, note="CS → pin 9")
    # connectors: right edge in Teensy pin order, B-link + GNSS cell on the left edge, power at the top
    place_row(b, "J9", 45, 40, ["O3", "UV", "GND"], "analog to C J7", direction="down", jst=True)
    place_row(b, "J6", 45, 36, ["SDA1", "SCL1", "3V3", "GND"], "I2C to C J1", direction="down", jst=True)
    place_row(b, "J8", 45, 31, ["GNSS", "GND"], "GNSS to D J5", direction="down", jst=True)
    place_row(b, "J4", 45, 28, ["RX3", "TX3", "GND"], "UART to D J2", direction="down", jst=True)
    place_row(b, "J5", 3, 24, ["HB", "GNSS", "MUX_TX", "MUX_RX", "GND"], "LINK cable to BACKUP J2", direction="down", jst=True)
    place_row(b, "J2", 26, 52, ["SCL", "SDA", "GND"], "I2C to E J2", jst=True)
    place_row(b, "J3", 43, 57, ["VBAT", "GND"], "VBAT from E J10", jst=True)
    place_row(b, "J1", 21, 52, ["+5V", "GND", "+3V3", "GND"], "PWR from E J5", jst=True)
    place_row(b, "J7", 3, 47, ["CELL+", "GND"], "GNSS backup cell", jst=True)
    # passives (1/4 W resistors flat on 4 pitches, LEDs and diodes standing)
    place_2pin(b, "R1", 17, 9, 17, 13, "10k LORA_CS↑")
    place_2pin(b, "R2", 17, 3, 17, 7, "10k FLASH_CS↑")
    place_2pin(b, "R3", 10, 33, 14, 33, "1k HB")
    place_2pin(b, "R4", 39, 29, 43, 29, "1k TX3")
    place_2pin(b, "R5", 10, 37, 14, 37, "1k GNSS→D")
    place_2pin(b, "R6", 10, 35, 14, 35, "1k GNSS→B")
    place_2pin(b, "R7", 39, 54, 43, 54, "100k VBAT")
    place_2pin(b, "R8", 39, 52, 43, 52, "22k VBAT")
    place_2pin(b, "R9", 19, 19, 19, 15, "470 LED OK")
    place_2pin(b, "R10", 18, 18, 18, 14, "470 LED FLT")
    place_2pin(b, "R11", 10, 31, 14, 31, "1k CAM TX")
    # Adafruit MAX98357A I2S amp (beacon) on firmware pins 2/3/4 + SD 37; speaker on its screw terminal
    place_fp(b, "U9", "MAX98357A_hdr7", "1", 32, 10, 0, "MAX98357A beacon amp", AMP, 9.0, C_PWR,
             note="speaker on the amp screw terminal\n(+ and - only, neither is GND)")
    place_2pin(b, "R12", 39, 4, 43, 4, "100k GAIN↓ 15dB")
    place_2pin(b, "C6", 40, 8, 42, 8, "100µF amp", kind="CP")
    place_2pin(b, "D1", 19, 12, 19, 11, "LED green", kind="LED_G")
    place_2pin(b, "D2", 18, 11, 18, 10, "LED red", kind="LED_R")
    place_2pin(b, "D3", 4, 51, 4, 55, "Schottky 3V3→BAT", kind="D")
    place_2pin(b, "D4", 2, 51, 2, 55, "Schottky cell→BAT", kind="D")
    place_2pin(b, "C1", 21, 55, 23, 55, "470µF", kind="CP")
    place_2pin(b, "C2", 25, 55, 27, 55, "100nF", kind="C")
    place_2pin(b, "C3", 6, 18, 6, 20, "100nF", kind="C")
    place_2pin(b, "C4", 31, 33, 33, 33, "100nF", kind="C")
    place_2pin(b, "C5", 40, 42, 42, 42, "100nF", kind="C")
    b.keepout = [(50.5, 104.5, 69.5, 118.0, "USB plug\nkeep clear"), (50.5, 30.0, 69.5, 43.0, "microSD\npull-out")]

    T = lambda p: ("U1", p)
    b.nets = [
        Net("GND", [T("GND1"), T("GND2"), T("GND3"), ("U2", "2"), ("U2", "10"), ("U2", "15"), ("U3", "12"),
                    ("U4", "4"), ("U5", "3"), ("U6", "3"), ("U6", "9"), ("U6", "12"), ("U7", "6"),
                    ("J1", "2"), ("J1", "4"), ("J2", "3"), ("J3", "2"), ("J6", "4"), ("J9", "3"), ("J4", "3"), ("J8", "2"), ("J5", "5"), ("U9", "6"), ("R12", "2"), ("C6", "2"),
                    ("J7", "2"), ("R8", "2"), ("D1", "2"), ("D2", "2"), ("C1", "2"), ("C2", "2"), ("C3", "2"),
                    ("C4", "2"), ("C5", "2")], kind="wire"),
        Net("+5V_LOGIC", [("J1", "1"), T("VIN"), ("C1", "1"), ("C2", "1"), ("U9", "7"), ("C6", "1")], kind="wire"),
        Net("+3V3_A", [("J1", "3"), ("U2", "16"), ("U3", "11"), ("U3", "2"), ("U4", "3"),
                       ("U5", "1"), ("U5", "5"), ("U5", "7"), ("U6", "1"), ("U7", "1"), ("R1", "2"), ("R2", "2"),
                       ("J6", "3"), ("C3", "1"), ("C4", "1"), ("C5", "1"), ("D3", "1")], kind="wire"),
        Net("GNSS_VBCKP", [("U3", "8"), ("D3", "2"), ("D4", "2")]),
        Net("GNSS_CELL", [("J7", "1"), ("D4", "1")]),
        Net("ICM_1V8", [("U6", "2"), ("U6", "7"), ("U6", "8")]),
        Net("SDA", [T("18"), ("U4", "2"), ("U5", "6"), ("U6", "5"), ("J2", "2")]),
        Net("SCL", [T("19"), ("U4", "1"), ("U5", "4"), ("U6", "4"), ("J2", "1")]),
        Net("GNSS_TX", [("U3", "9"), T("7"), ("R5", "1"), ("R6", "1")]),
        Net("GNSS_RX", [("U3", "10"), T("8")]),
        Net("GNSS_RST", [("U3", "7"), T("6")]),
        Net("LORA_CS", [("U2", "3"), T("29"), ("R1", "1")]),
        Net("LORA_BUSY", [("U2", "8"), T("24")]),
        Net("LORA_RST", [("U2", "7"), T("25")]),
        Net("LORA_IRQ", [("U2", "11"), T("30")]),
        Net("MOSI1", [T("26"), ("U2", "5"), ("U7", "5")]),
        Net("SCK1", [T("27"), ("U2", "4"), ("U7", "4")]),
        Net("MISO1", [T("39"), ("U2", "6"), ("U7", "3")]),
        Net("FLASH_CS", [T("9"), ("U7", "2"), ("R2", "1")]),
        Net("HB_OUT", [T("5"), ("R3", "1")]),
        Net("HB_J5", [("R3", "2"), ("J5", "1")]),
