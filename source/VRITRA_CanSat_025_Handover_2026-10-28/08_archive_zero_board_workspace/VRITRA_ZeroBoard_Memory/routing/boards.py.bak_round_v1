# ===========================================================================
# BOARD E — POWER (next to the battery). High current = thick wire, never traces.
# ===========================================================================
def _module(b, ref, x0, y0, w, h, label, c, r, note=""):
    """Buck module as a box + a 3-hole landing row [IN, GND, OUT] next to it.
    Solder short wires from the module's own VIN/GND/VOUT pads (check its
    silkscreen) to these holes — no module pin order is assumed."""
    place_box(b, ref, x0, y0, x0 + w, y0 + h, label, C_PWR, height=8.0, note=note)
    place_row(b, ref + "L", c, r, ["IN", "GND", "OUT"], ref + " landing", direction="down", height=3.0)


def board_e() -> Board:
    _z.set_board(120.0, 150.0)
    b = Board("E", "Board E POWER", keep_x=(0.0, 120.0), plane_y=None)
    b.notes = ["Battery, ESC and 8 V paths: ≥18 AWG silicone wire. 5 V/3V3 distribution: 22 AWG. INA260 IN+/IN− take the "
               "thick wire directly. INA260 I²C addresses: set the module's A0/A1 pads to 0x40 / 0x41 / 0x45 and confirm by scan."]
    place_fp(b, "U1", "INA260_7Semi_hdr8", "1", 5, 50, 0, "INA260 #1 BATTERY", INA, 6.0, C_PWR, note="0x40")
    place_fp(b, "U3", "INA260_7Semi_hdr8", "1", 5, 30, 0, "INA260 #3 5V LOGIC", INA, 6.0, C_PWR, note="0x45")
    place_fp(b, "U2", "INA260_7Semi_hdr8", "1", 5, 14, 0, "INA260 #2 8V STEER", INA, 6.0, C_PWR, note="0x41")
    _module(b, "M1", 52, 112, 21, 18, "AP64500 #1 → +5V_LOGIC", 19, 50)
    _module(b, "M2", 90, 112, 21, 18, "AP64500 #2 → +5V_SERVO", 34, 50)
    _module(b, "M3", 52, 80, 45, 25, "8 V multi-output buck", 19, 40, note="A20CLM steering only")
