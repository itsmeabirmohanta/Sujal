        Net("GND", [("J1", "4"), ("J7", "3"), ("J3", "2"), ("J2", "2"), ("J4", "2"), ("J8", "2"), ("J5", "2"), ("J6", "2"),
                    ("R5", "2"), ("C1", "2")], kind="wire"),
        Net("+3V3_A", [("J1", "3"), ("J2", "1"), ("J4", "1"), ("J8", "1"), ("J5", "1"), ("R1", "2"), ("R2", "2"),
                       ("C1", "1")], kind="wire"),
        Net("+5V_MQ", [("J3", "1"), ("J6", "1")], kind="wire"),
