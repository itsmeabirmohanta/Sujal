    _module(b, "M5", 80, 45, 18, 16, "AP62301 #2 → +3V3_B", 30, 22)
    for m in ("M1L", "M2L", "M3L", "M4L", "M5L"):
        c, r = b.parts[m].pins["1"]
        place_row(b, m, c, r, ["IN", "GND", "OUT"], m[:2] + " landing", direction="down", height=3.0)
    place_row(b, "J1", 2, 57, ["BAT+", "BAT−"], "BATTERY (XT60 lead)", height=10.0)
    place_row(b, "J3", 6, 57, ["SW_A", "SW_B"], "rocker switch (shell)")
    place_row(b, "F1", 10, 57, ["IN", "OUT"], "FUSE 10 A (link until fitted)")
    place_2pin(b, "R1", 14, 54, 18, 54, "1k LED")
