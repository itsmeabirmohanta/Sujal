# expected Teensy pin -> net, copied from 03_PIN_MAP_AND_WIRING.md §1 (independent cross-check)
EXPECT_A = {"0": "CAM_RX", "1": "CAM_TX", "2": "AMP_DIN", "3": "AMP_LRC", "4": "AMP_BCLK", "37": "AMP_SD",
            "5": "HB_OUT", "6": "GNSS_RST", "7": "GNSS_TX", "8": "GNSS_RX", "14": "TX3", "15": "RX3",
            "16": "SCL1", "17": "SDA1", "18": "SDA", "19": "SCL", "20": "BUS_V", "23": "ENV_O3", "24": "LORA_BUSY",
            "25": "LORA_RST", "26": "MOSI1", "27": "SCK1", "29": "LORA_CS", "30": "LORA_IRQ", "31": "LED_OK",
            "32": "LED_FLT", "9": "FLASH_CS", "39": "MISO1", "22": "ENV_UV", "VIN": "+5V_LOGIC",
            "GND1": "GND", "GND2": "GND", "GND3": "GND"}
FORBIDDEN_A = {"33", "34", "35", "36", "3V3_1", "3V3_2"}


def check_pins(b: Board, ref: str, expect: dict, forbidden: set) -> list[str]:
    got = {pad: n.name for n in b.nets for r, pad in n.pins if r == ref}
    msgs = [f"{ref}.{p}: expected {n}, got {got.get(p)}" for p, n in expect.items() if got.get(p) != n]
    msgs += [f"{ref}.{p}: in {got[p]} but pin is reserved / must stay free" for p in forbidden if p in got]
    msgs += [f"{ref}.{p}: wired to {got[p]} but not in the pin map" for p in got if p not in expect]
    return msgs


# ===========================================================================
# BOARD B — BACKUP Teensy 4.1 #2 (logger; no radio unless a 2nd Core1121 is bought)
# ===========================================================================
def board_b() -> Board:
    b = Board("B", "Board 2 BACKUP + SENSOR (Teensy 4.1 #2)", keep_x=(0.0, 120.0), plane_y=None)
    b.notes = ["Only one Core1121 flies, so B logs to its own microSD and watches A's heartbeat. "
               "U10 camera mux: channel 1 = MAIN Teensy (default, held by 10k pull-downs), channel 2 = this Teensy "
               "after a takeover. Mux bottom row is off the 2.54 grid: fit header pins UP and run 5 short wires to the "
               "U10B landing holes. Mux DIP switches OFF, VCC jumper on 3V3."]
    place_fp(b, "U1", "Teensy 4.1_hdr", "0", 21, 40, 270, "Teensy 4.1 BACKUP", T41_NAMES, 13.0, C_MCU,
             note="on female headers\nUSB up · microSD down")
    place_fp(b, "U5", "BMP585_hdr8", "1", 31, 36, 0, "BMP585 #2", BMP, 6.0, C_SENS, note="0x47 (SDO→3V3)")
    place_fp(b, "U8", "LSM6DSO32_hdr", "1", 31, 44, 0, "LSM6DSO32 (Adafruit)", LSM, 6.0, C_SENS,
             note="I²C mode: CS→3V3, DO→GND = 0x6A · ±32 g\nsolder only the 9-pin FRONT row")
    place_row(b, "J1", 21, 52, ["+5V", "GND", "+3V3", "GND"], "PWR from E J6", jst=True)
    place_row(b, "J2", 3, 41, ["HB", "GNSS", "MUX_TX", "MUX_RX", "GND"], "LINK cable from MAIN J5", direction="down", jst=True)
    place_row(b, "J3", 45, 31, ["RX3", "TX3", "GND"], "to D J3", direction="down", jst=True)
    place_row(b, "J4", 45, 22, ["+5V", "GND", "to D7", "from D6"], "CAMERA plug (the only one)", direction="down", jst=True)
    # 7Semi 4-channel UART mux (BO-10145): side columns on the grid, bottom row via 5 short wires
    place_fp(b, "U10", "UART_MUX_7SEMI_25", "1", 29, 15, 0, "7Semi UART mux", MUX, 8.0, C_PWR,
             note="ch1 = MAIN · ch2 = BACKUP\nDIP OFF · VCC jumper 3V3", pins_used={str(i) for i in range(1, 21)})
    place_row(b, "U10B", 30, 3, ["5V", "3V3", "GND", "RX_COM", "TX_COM"], "mux bottom-row wires", height=3.0,
              color=C_PWR)
    place_2pin(b, "R1", 38, 29, 42, 29, "1k TX3")
    place_2pin(b, "R2", 29, 20, 33, 20, "1k TX8")
    place_2pin(b, "R3", 29, 18, 33, 18, "1k RX8")
    place_2pin(b, "R9", 38, 17, 42, 17, "1k cam RX")
    place_2pin(b, "R10", 38, 15, 42, 15, "1k cam TX")
    place_2pin(b, "R6", 14, 30, 18, 30, "10k MUX_A↓")
    place_2pin(b, "R7", 14, 28, 18, 28, "10k MUX_B↓")
    place_2pin(b, "R8", 14, 26, 18, 26, "10k MUX_C↓")
    place_2pin(b, "R4", 29, 23, 33, 23, "470 LED OK")
    place_2pin(b, "R5", 29, 25, 33, 25, "470 LED FLT")
    place_2pin(b, "D1", 35, 23, 35, 22, "LED green", kind="LED_G")
    place_2pin(b, "D2", 35, 26, 35, 25, "LED red", kind="LED_R")
    place_2pin(b, "C1", 21, 55, 23, 55, "470µF", kind="CP")
    place_2pin(b, "C2", 25, 55, 27, 55, "100nF", kind="C")
    place_2pin(b, "C3", 31, 33, 33, 33, "100nF", kind="C")
    place_2pin(b, "C4", 42, 42, 44, 42, "100nF", kind="C")
    # microSD card module (6-pin, 74xx125 buffer + regulator): flat on a straight header,
    # card slot toward the TOP edge; alone on SPI0 (pins 10-13) because its MISO never tri-states
    sd = place_row(b, "U11", 7, 41, ["CS", "SCK", "MOSI", "MISO", "VCC", "GND"], "microSD card module",
                   height=8.0, color=C_SENS, note="straight header, module FLAT\ncard slot → top edge · VCC = 5 V")
    sd.body = (hx(7) + 6.35 - 12.0, hy(41) - 2.0, hx(7) + 6.35 + 12.0, hy(41) + 42.0)
    # HDC3020 (7Semi cable module, silk + - D C): module on 2 screws, cable wires soldered to M1L
    place_box(b, "M1", 96.0, 128.0, 118.0, 144.0, "HDC3020 (7Semi)", C_SENS, height=6.0,
              note="2× M2 screws · JST-PH cable\n+ - D C → 3V3 GND SDA SCL · 0x44")
    place_row(b, "M1L", 41, 50, ["3V3", "GND", "SDA", "SCL"], "HDC3020 cable wires", height=3.0, color=C_SENS)
    b.keepout = [(50.5, 104.5, 69.5, 118.0, "USB plug\nkeep clear"), (50.5, 30.0, 69.5, 43.0, "microSD\npull-out")]
    T = lambda p: ("U1", p)
    b.nets = [
        Net("GND", [T("GND1"), T("GND2"), T("GND3"), ("U5", "3"), ("U8", "3"), ("U8", "6"), ("J1", "2"),
                    ("J1", "4"), ("J2", "5"), ("J3", "3"), ("J4", "2"), ("D1", "2"), ("D2", "2"), ("C1", "2"),
                    ("C2", "2"), ("C3", "2"), ("C4", "2"), ("U10", "4"), ("U10", "20"), ("U10B", "3"),
                    ("R6", "2"), ("R7", "2"), ("R8", "2"), ("U11", "6"), ("M1L", "2")], kind="wire"),
        Net("+5V_LOGIC", [("J1", "1"), T("VIN"), ("C1", "1"), ("C2", "1"), ("J4", "1"), ("U11", "5")], kind="wire"),
        Net("+3V3_B", [("J1", "3"), ("U5", "1"), ("U5", "5"), ("U5", "7"), ("U8", "1"), ("U8", "7"),
                       ("C3", "1"), ("C4", "1"), ("U10B", "2"), ("M1L", "1")], kind="wire"),
        Net("SD_CS", [T("10"), ("U11", "1")]),
        Net("SD_SCK", [T("13"), ("U11", "2")]),
        Net("SD_MOSI", [T("11"), ("U11", "3")]),
        Net("SD_MISO", [T("12"), ("U11", "4")]),
        Net("CAM_TX_J", [("J2", "3"), ("U10", "2")]),
        Net("CAM_RX", [("J2", "4"), ("U10", "3")]),
        Net("MUX_A", [T("5"), ("U10", "9"), ("R6", "1")]),
        Net("MUX_B", [T("6"), ("U10", "10"), ("R7", "1")]),
        Net("MUX_C", [T("9"), ("U10", "19"), ("R8", "1")]),
