PALETTE = ["#1f77b4", "#2ca02c", "#9467bd", "#8c564b", "#e377c2", "#17becf", "#bcbd22",
           "#ff7f0e", "#7f7f7f", "#393b79", "#637939", "#8c6d31", "#843c39", "#7b4173",
           "#3182bd", "#31a354", "#756bb1", "#e6550d", "#636363", "#6baed6"]
FIXED = {"GND": "#000000", "+3V3_A": "#e69500", "+3V3_B": "#e69500", "+5V_LOGIC": "#d62728",
         "+5V": "#d62728", "+8V_STEER": "#6a0dad", "+5V_SERVO": "#c2185b", "VBAT": "#b71c1c"}


def net_colors(b: Board):
    cols, i = {}, 0
    for n in b.nets:
        if n.name in FIXED:
            cols[n.name] = FIXED[n.name]
        else:
            cols[n.name] = PALETTE[i % len(PALETTE)]
            i += 1
    return cols


def _sheet(title, sub):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=(11.5, 13.2), dpi=240)
    ax.set_aspect("equal")
    ax.axis("off")
    ax.set_xlim(-24, BOARD_W + 24)
    ax.set_ylim(-16, BOARD_H + 8)
    ax.set_title(title, fontsize=10.5, fontweight="bold", loc="left")
    ax.text(-20, -9, sub, fontsize=6.0, va="top", wrap=True)
    return fig, ax, plt


def _board_bg(ax, b: Board, mirror: bool):
    from matplotlib.patches import Rectangle
    X = (lambda x: BOARD_W - x) if mirror else (lambda x: x)
    ax.add_patch(Rectangle((0, 0), BOARD_W, BOARD_H, fc="#cfe3cf" if not mirror else "#e8d9b8",
                           ec="k", lw=1.4, zorder=0))
    k0, k1 = b.keep_x
    for a0, a1 in ((0, k0), (k1, BOARD_W)):
        if a1 - a0 > 0.1:
            xa, xb = sorted((X(a0), X(a1)))
            ax.add_patch(Rectangle((xa, 0), xb - xa, BOARD_H, fc="#ffdddd", ec="red", hatch="///",
                                   lw=0.6, alpha=0.6, zorder=1))
            ax.text((xa + xb) / 2, BOARD_H / 2, f"TRIM {a1 - a0:.0f} mm", rotation=90, color="red",
                    fontsize=6, ha="center", va="center", fontweight="bold", zorder=2)
    xs = [X(hx(c)) for c in range(1, NC + 1)]
    ys = [hy(r) for r in range(1, NR + 1)]
    ax.scatter([x for x in xs for _ in ys], [y for _ in xs for y in ys], s=1.3, c="#6d7d6d", zorder=2)
    for c in range(1, NC + 1, 2):
        ax.text(X(hx(c)), -2.2, str(c), fontsize=3.6, ha="center", va="top")
        ax.text(X(hx(c)), BOARD_H + 1.0, str(c), fontsize=3.6, ha="center", va="bottom")
    for r in range(1, NR + 1, 2):
        ax.text(-1.2, hy(r), str(r), fontsize=3.6, ha="right", va="center")
        ax.text(BOARD_W + 1.2, hy(r), str(r), fontsize=3.6, ha="left", va="center")
    ax.text(-1.2, -2.2, "R\\C", fontsize=3.6, ha="right", va="top")
    return X


def render_top(b: Board, results, path):
    from matplotlib.patches import Rectangle, Circle
    fig, ax, plt = _sheet(f"{b.title} — COMPONENT SIDE (pin holes + placement)",
                          "View from the component side. C = column (1 at left), R = row (1 at bottom). Each pin hole shows its pin "
                          "name; blue text = net. Thick right-angled lines = insulated POWER wires laid on this side (GND black, "
                          "3V3 orange, 5V red) — solder each end into the pin hole shown. Signals are on the solder side (other sheet). "
                          + " ".join(b.notes))
    X = _board_bg(ax, b, mirror=False)
    cols = net_colors(b)
    pin_net = {(ref, pad): n.name for n in b.nets for ref, pad in n.pins}
    for x0, y0, x1, y1, lab in b.keepout:
        ax.add_patch(Rectangle((x0, y0), x1 - x0, y1 - y0, fc="none", ec="red", ls=":", lw=0.9, zorder=3))
        ax.text((x0 + x1) / 2, (y0 + y1) / 2, lab, fontsize=4.5, color="red", ha="center", va="center", zorder=3)
    for p in b.parts.values():
        x0, y0, x1, y1 = p.body
        ax.add_patch(Rectangle((x0, y0), x1 - x0, y1 - y0, fc="white" if p.dashed else p.color, ec="k",
                               lw=0.8, ls="--" if p.dashed else "-", alpha=0.55 if not p.dashed else 0.9, zorder=3))
        big = (x1 - x0) * (y1 - y0) > 120
        ax.text((x0 + x1) / 2, y1 - 1.2, f"{p.ref} {p.label}", fontsize=5.0 if big else 3.6, ha="center", va="top",
                fontweight="bold", zorder=6)
        if p.note and big:
            ax.text((x0 + x1) / 2, y0 + 1.0, p.note, fontsize=3.6, ha="center", va="bottom", zorder=6, linespacing=1.0)
        for pad, (c, r) in p.pins.items():
            net = pin_net.get((p.ref, pad))
            ax.add_patch(Circle((hx(c), hy(r)), 0.85, fc=cols.get(net, "#bbbbbb") if net else "#ffffff",
                                ec="k", lw=0.4, zorder=7))
            ax.text(hx(c) + 1.0, hy(r) + 0.5, p.names.get(pad, pad), fontsize=3.0, zorder=8, fontweight="bold")
            if net:
                ax.text(hx(c) + 1.0, hy(r) - 0.8, net, fontsize=2.6, color="#0b3d91", zorder=8)
    for name, res in results.items():
        for a, c in res["jumpers"]:
            if res.get("wire"):
                xs, ys = [hx(a[0]), hx(c[0]), hx(c[0])], [hy(a[1]), hy(a[1]), hy(c[1])]
                ax.plot(xs, ys, lw=2.2, color=cols[name], alpha=0.55, solid_capstyle="round", zorder=9)
            else:
                ax.plot([hx(a[0]), hx(c[0])], [hy(a[1]), hy(c[1])], ls="--", lw=0.9, color=cols[name], zorder=9)
    fig.savefig(path, bbox_inches="tight")
    plt.close(fig)


def render_bottom(b: Board, results, path):
    from matplotlib.patches import Rectangle, Circle
    fig, ax, plt = _sheet(f"{b.title} — SOLDER SIDE (traces), board flipped left-right",
                          "This is what you see after turning the board over (mirror image of the component side): column 1 is now on "
                          "the RIGHT. Solid lines = bottom traces: bridge neighbouring holes with solder or lay bare tinned wire along "
                          "the holes shown. Little arches = HOP: a short insulated wire on this side that jumps over the trace "
                          "beneath it (do not solder the hole in the middle). Power (GND/3V3/5V) is wired on the component side. "
                          "Every hole a trace passes through belongs to that net only.")
    X = _board_bg(ax, b, mirror=True)
    cols = net_colors(b)
    for p in b.parts.values():
        x0, y0, x1, y1 = p.body
        xa, xb = sorted((X(x0), X(x1)))
        ax.add_patch(Rectangle((xa, y0), xb - xa, y1 - y0, fc="none", ec="#999", lw=0.5, ls=":", zorder=3))
        ax.text((xa + xb) / 2, y1 - 1.0, p.ref, fontsize=4.0, color="#777", ha="center", va="top", zorder=3)
    labelled = set()
    for name, res in results.items():
        col = cols[name]
        lw = 2.0 if name in POWER_LAST else 1.3
        for path_ in res["segs"]:
            ax.plot([X(hx(c)) for c, r in path_], [hy(r) for c, r in path_], color=col, lw=lw,
                    solid_capstyle="round", zorder=5)
            if name not in labelled and len(path_) > 2:
                mid = path_[len(path_) // 2]
                ax.text(X(hx(mid[0])), hy(mid[1]) + 0.9, name, fontsize=3.2, color=col, ha="center",
                        zorder=9, bbox=dict(fc="white", ec="none", alpha=0.75, pad=0.2))
                labelled.add(name)
        for a, c in res["jumpers"]:
            if res.get("wire"):
                continue                      # power wires live on the component side
            ax.plot([X(hx(a[0])), X(hx(c[0]))], [hy(a[1]), hy(c[1])], color=col, ls="--", lw=0.9, zorder=6)
        for a, c in res.get("hops", []):
            xa, xc, ya, yc = X(hx(a[0])), X(hx(c[0])), hy(a[1]), hy(c[1])
            mx, my = (xa + xc) / 2, (ya + yc) / 2
            off = 1.3 if a[1] == c[1] else 0.0
            offx = 1.3 if a[0] == c[0] else 0.0
            ax.plot([xa, mx + offx, xc], [ya, my + off, yc], color=col, lw=1.6, zorder=10)
            ax.plot([xa, mx + offx, xc], [ya, my + off, yc], color="white", lw=0.5, zorder=11)
    pin_net = {(ref, pad): n.name for n in b.nets for ref, pad in n.pins}
    for p in b.parts.values():
        for pad, (c, r) in p.pins.items():
            net = pin_net.get((p.ref, pad))
            ax.add_patch(Circle((X(hx(c)), hy(r)), 0.9, fc=cols.get(net, "white") if net else "white",
                                ec="k", lw=0.4, zorder=7))
            ax.text(X(hx(c)) - 1.0, hy(r) + 0.55, f"{p.ref}.{p.names.get(pad, pad)}", fontsize=2.3, ha="right", zorder=8)
    fig.savefig(path, bbox_inches="tight")
    plt.close(fig)


def wiring_list(b: Board, results) -> str:
    lines = [f"# {b.title} — wiring list", "",
             "Hole = C(column from left on the component side) R(row from bottom).",
             "Bottom runs are listed as straight segments; solder-bridge every hole in each segment.", ""]
    for n in b.nets:
        res = results[n.name]
        pins = ", ".join(f"{ref}.{b.parts[ref].names.get(pad, pad)} (C{b.parts[ref].pins[pad][0]} R{b.parts[ref].pins[pad][1]})"
                         for ref, pad in n.pins)
        lines.append(f"## {n.name}" + ("  — THICK INSULATED WIRE, point to point" if res.get("wire") else ""))
        lines.append(f"- pins: {pins}")
        for path_ in res["segs"]:
            runs, start = [], path_[0]
            for i in range(1, len(path_)):
                if i == len(path_) - 1 or (path_[i + 1][0] - path_[i][0], path_[i + 1][1] - path_[i][1]) != \
                        (path_[i][0] - path_[i - 1][0], path_[i][1] - path_[i - 1][1]):
                    runs.append(f"C{start[0]}R{start[1]}→C{path_[i][0]}R{path_[i][1]}")
                    start = path_[i]
            lines.append("- bottom: " + " · ".join(runs))
        for a, c in res.get("hops", []):
            lines.append(f"- insulated HOP wire (solder side, over the other trace): C{a[0]}R{a[1]} ↔ C{c[0]}R{c[1]}")
        for a, c in res["jumpers"]:
            lines.append(f"- {'wire' if res.get('wire') else 'insulated jumper'}: C{a[0]}R{a[1]} ↔ C{c[0]}R{c[1]}")
        lines.append("")
    return "\n".join(lines)
