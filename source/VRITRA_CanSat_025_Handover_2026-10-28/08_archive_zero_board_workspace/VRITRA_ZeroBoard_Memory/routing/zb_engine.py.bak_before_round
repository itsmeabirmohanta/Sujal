"""Zero-board (perfboard) placement + hole-grid router + renderer.

Board: 120 x 150 mm double-sided perfboard, 2.54 mm pitch, 47 x 59 holes.
Hole C1 R1 = bottom-left hole seen from the COMPONENT side; C counts right,
R counts up (up = toward the parachute bay).

Traces run on the BOTTOM (solder side) from hole to hole, orthogonal only:
a run of solder bridges or a bare tinned wire laid on the holes. A net that
cannot be routed on the bottom gets a TOP jumper (insulated wire) instead.
Pin geometry for modules is read from the team's own KiCad footprints
(VRITRA_footprints.pretty), so hole offsets are the measured ones.
"""
from __future__ import annotations

import heapq
import math
import os
import re
from dataclasses import dataclass, field

PITCH = 2.54
BOARD_W, BOARD_H = 120.0, 150.0
NC, NR = 47, 59
X0 = (BOARD_W - (NC - 1) * PITCH) / 2
Y0 = (BOARD_H - (NR - 1) * PITCH) / 2
FP_LIB = r"C:\Users\kalbh\Documents\KiCad\cansat final pcb\Board 1\VRITRA_footprints.pretty"
SHELL_R = 59.0          # 120 mm inner diameter, 1 mm clearance
ROD_EDGE = 42.5         # rods Ø8 at r=47 -> keep 4.5 mm off their centre


def set_board(w: float, h: float, x0: float | None = None, y0: float | None = None) -> None:
    """Re-size the grid for another board (etched PCB). Holes stay on 2.54 mm;
    x0 / y0 pin the first hole so a board can be shortened without moving parts."""
    global BOARD_W, BOARD_H, NC, NR, X0, Y0
    BOARD_W, BOARD_H = w, h
    NC = int((w - 2.0) / PITCH) + 1 if x0 is None else int((w - x0 - 1.0) / PITCH) + 1
    NR = int((h - 2.0) / PITCH) + 1 if y0 is None else int((h - y0 - 1.0) / PITCH) + 1
    X0 = (w - (NC - 1) * PITCH) / 2 if x0 is None else x0
    Y0 = (h - (NR - 1) * PITCH) / 2 if y0 is None else y0


def hx(c: int) -> float:
    return X0 + (c - 1) * PITCH


def hy(r: int) -> float:
    return Y0 + (r - 1) * PITCH


def _rot(u: float, v: float, rot: int) -> tuple[float, float]:
    """Rotate a board-up vector (u right, v up) CCW by rot degrees."""
    return {0: (u, v), 90: (-v, u), 180: (-u, -v), 270: (v, -u)}[rot]


@dataclass
class Part:
    ref: str
    label: str
    pins: dict            # pad id -> (c, r)
    names: dict           # pad id -> pin name
    body: tuple           # (x0, y0, x1, y1) mm, component-side view
    height: float         # tallest point above the board, mm
    color: str
    note: str = ""
    dashed: bool = False
    fit_check: bool = True


@dataclass
class Net:
    name: str
    pins: list            # [(ref, pad), ...]
    kind: str = "trace"   # trace | wire (thick insulated wire, not routed)


@dataclass
class Board:
    key: str
    title: str
    keep_x: tuple         # usable x range (mm) after trimming
    plane_y: float | None # board plane offset from can axis (None = no fit check)
    face_out: bool = True
    parts: dict = field(default_factory=dict)
    nets: list = field(default_factory=list)
    notes: list = field(default_factory=list)
    keepout: list = field(default_factory=list)   # (x0,y0,x1,y1,label) top-side clear zones


# ---------------------------------------------------------------------------
# footprints
# ---------------------------------------------------------------------------
def load_fp(name: str):
    s = open(os.path.join(FP_LIB, name + ".kicad_mod"), encoding="utf-8").read()
    pads = [(m.group(1), float(m.group(3)), float(m.group(4)))
            for m in re.finditer(r'\(pad\s+"([^"]*)"\s+(thru_hole)\s+\w+\s*\(at\s+([-\d.]+)\s+([-\d.]+)', s)
            if m.group(1)]
    crt = []
    for m in re.finditer(r'\((fp_rect|fp_line|fp_poly)(.*?)\(layer\s+"?F\.CrtYd"?\)', s, re.S):
        crt += [(float(a), float(b)) for a, b in re.findall(r'\((?:start|end|xy)\s+([-\d.]+)\s+([-\d.]+)\)', m.group(2))]
    return pads, crt


def place_fp(b: Board, ref, fp, anchor_pad, c, r, rot, label, names, height, color, note="", pins_used=None):
    pads, crt = load_fp(fp)
    ax_, ay_ = next((x, y) for p, x, y in pads if p == anchor_pad)
    pins = {}
    for p, x, y in pads:
        if pins_used is not None and p not in pins_used:
            continue
        gu, gv = round((x - ax_) / PITCH), round(-(y - ay_) / PITCH)
        dc, dr = _rot(gu, gv, rot)
        pins[p] = (c + int(dc), r + int(dr))
    cx, cy = hx(c), hy(r)
    pts = [_rot(x - ax_, -(y - ay_), rot) for x, y in crt]
    body = (cx + min(p[0] for p in pts), cy + min(p[1] for p in pts),
            cx + max(p[0] for p in pts), cy + max(p[1] for p in pts))
    b.parts[ref] = Part(ref, label, pins, {k: names.get(k, k) for k in pins}, body, height, color, note)
    return b.parts[ref]


def place_row(b: Board, ref, c, r, names, label, direction="right", height=8.5, color="#d9b3ff",
              body_pad=(1.3, 1.3), note="", fit_check=True, jst=False):
    """Single-row header / connector. names in pin-1-first order."""
    dc, dr = {"right": (1, 0), "left": (-1, 0), "up": (0, 1), "down": (0, -1)}[direction]
    pins, nm = {}, {}
    for i, n in enumerate(names):
        pins[str(i + 1)] = (c + dc * i, r + dr * i)
        nm[str(i + 1)] = n
    xs = [hx(p[0]) for p in pins.values()]
    ys = [hy(p[1]) for p in pins.values()]
    if jst:
        # JST-XH vertical (B#B-XH-A): 2.5 mm pitch (fits 2.54 holes up to 5 pins),
        # housing reaches 2.45 mm past the end pins and is 5.75 mm deep.
        if not 2 <= len(names) <= 5:
            raise ValueError(f"{ref}: JST connectors here are 2..5 pins, got {len(names)}")
        along, across = 2.45, 2.9
        body_pad = (along, across) if direction in ("right", "left") else (across, along)
        height = 7.0
    body = (min(xs) - body_pad[0], min(ys) - body_pad[1], max(xs) + body_pad[0], max(ys) + body_pad[1])
    b.parts[ref] = Part(ref, label, pins, nm, body, height, color, note, fit_check=fit_check)
    b.parts[ref].jst = jst
    return b.parts[ref]


def place_2pin(b: Board, ref, c1, r1, c2, r2, label, kind="R", height=None):
    color = {"R": "#f2e6c9", "C": "#cfe2f3", "CP": "#9fc5e8", "LED_G": "#2ecc40", "LED_R": "#ff4136",
             "D": "#cccccc"}[kind]
    h = height if height is not None else {"R": 2.5, "C": 5.0, "CP": 9.0, "LED_G": 6.0, "LED_R": 6.0,
                                           "D": 2.5}[kind]
    x1, y1, x2, y2 = hx(c1), hy(r1), hx(c2), hy(r2)
    pad = 1.2
    body = (min(x1, x2) - pad, min(y1, y2) - pad, max(x1, x2) + pad, max(y1, y2) + pad)
    polar = kind.startswith("LED") or kind == "D"
    names = {"1": "A" if polar else ("+" if kind == "CP" else "1"), "2": "K" if polar else ("-" if kind == "CP" else "2")}
    b.parts[ref] = Part(ref, label, {"1": (c1, r1), "2": (c2, r2)}, names, body, h, color)
    return b.parts[ref]


def place_box(b: Board, ref, x0, y0, x1, y1, label, color, height=10.0, note="", dashed=False, pins=None, names=None):
    b.parts[ref] = Part(ref, label, pins or {}, names or {}, (x0, y0, x1, y1), height, color, note, dashed,
                        fit_check=not dashed)
    return b.parts[ref]


