# checks
# ---------------------------------------------------------------------------
def fit_check(b: Board) -> list[str]:
    """Shell-curvature + rod + keep-zone check for every placed part."""
    msgs = []
    k0, k1 = b.keep_x
    for p in b.parts.values():
        if not p.fit_check:
            continue
        x0, y0, x1, y1 = p.body
        if x0 < k0 - 0.01 or x1 > k1 + 0.01 or y0 < 0 or y1 > BOARD_H:
            msgs.append(f"{p.ref}: body {x0:.1f}..{x1:.1f} x {y0:.1f}..{y1:.1f} leaves the keep zone {k0}..{k1}")
        if b.plane_y is None:
            continue
        tip = abs(b.plane_y) + 0.8 + p.height
        half = math.sqrt(max(SHELL_R ** 2 - tip ** 2, 0))
        ext = max(abs(x0 - 60), abs(x1 - 60))
        if ext > half:
            msgs.append(f"{p.ref}: {p.height:.0f} mm tall reaches |x|={ext:.1f} but the shell allows {half:.1f} at that height")
        if b.plane_y != 0 and tip > ROD_EDGE:
            msgs.append(f"{p.ref}: tip {tip:.1f} mm from axis hits the rod at r=47")
    if b.plane_y == 0 and (60 - k0 > ROD_EDGE or k1 - 60 > ROD_EDGE):
        msgs.append("board edge reaches the x=±47 rods")
    # pin holes must be unique
    seen = {}
    for p in b.parts.values():
        for pad, h in p.pins.items():
            if h in seen:
                msgs.append(f"hole C{h[0]} R{h[1]} used by {seen[h]} and {p.ref}.{pad}")
            seen[h] = f"{p.ref}.{pad}"
    # bodies of owned parts must not overlap
    owned = [p for p in b.parts.values() if not p.dashed]
    for i, a in enumerate(owned):
        for q in owned[i + 1:]:
            ax0, ay0, ax1, ay1 = a.body
            bx0, by0, bx1, by1 = q.body
            if ax0 < bx1 - 0.3 and bx0 < ax1 - 0.3 and ay0 < by1 - 0.3 and by0 < ay1 - 0.3:
                msgs.append(f"bodies overlap: {a.ref} and {q.ref}")
    return msgs


# ---------------------------------------------------------------------------
# router
# ---------------------------------------------------------------------------
DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))


def usable(b: Board, c: int, r: int) -> bool:
    x, y = hx(c), hy(r)
    k0, k1 = getattr(b, "copper_x", b.keep_x)      # copper margin is from the board edge, not the body zone
    return k0 + EDGE <= x <= k1 - EDGE and EDGE <= y <= BOARD_H - EDGE


EDGE = 3.0             # mm kept clear on every edge for the 3D-printed slot mount
HOP_COST = 9.0         # one short insulated wire hopping over a foreign trace
TURN_COST = 0.9
ITERATIONS = 40


def route(b: Board):
    """Negotiated-congestion (PathFinder-style) router on the hole grid.

    Every hole belongs to at most one net. A path may 'hop' two holes in a
    straight line over a foreign trace hole (never over a pin) — that hop is an
    insulated wire on the solder side. Nets are ripped up and re-routed with
    growing penalties on shared holes until no hole is shared; a final pass
    with hard blocking resolves any remainder with hops / long jumpers."""
    pin_owner = {}
    for n in b.nets:
        for ref, pad in n.pins:
            h = b.parts[ref].pins[pad]
            if h in pin_owner and pin_owner[h] != n.name:
                raise ValueError(f"pin {ref}.{pad} is in two nets: {pin_owner[h]} and {n.name}")
            pin_owner[h] = n.name
    for p in b.parts.values():     # unconnected pins still block their hole
        for pad, h in p.pins.items():
            pin_owner.setdefault(h, f"NC:{p.ref}.{pad}")
    pin_holes = set(pin_owner)

    trace_nets = sorted((n for n in b.nets if n.kind == "trace"),
                        key=lambda n: (n.name in POWER_LAST, _hpwl(b, n)))
    hist = {}
    usage = {}                     # hole -> set of nets (routed holes, excl. pins)

    def hole_cost(q, net, pres, hard):
        o = pin_owner.get(q)
        if o is not None and o != net:
            return None
        users = usage.get(q, set()) - {net}
        if users and hard:
            return None
        return (1.0 + hist.get(q, 0.0)) * (1.0 + pres * len(users))

    def dijkstra(net, sources, target, pres, hard):
        pq, best, prev = [], {}, {}
        for s in sources:
            heapq.heappush(pq, (0.0, s, -1))
            best[(s, -1)] = 0.0
        while pq:
            cost, cur, d = heapq.heappop(pq)
            if cur == target:
                path, st = [cur], (cur, d)
                while st in prev:
                    st = prev[st]
                    path.append(st[0])
                return path[::-1]
            if cost > best.get((cur, d), 1e18):
                continue
            c, r = cur
            for nd, (dc, dr) in enumerate(DIRS):
                for step, extra in ((1, 0.0), (2, HOP_COST)):
                    q = (c + dc * step, r + dr * step)
                    if not (1 <= q[0] <= NC and 1 <= q[1] <= NR) or not usable(b, *q):
                        continue
                    if step == 2:
                        mid = (c + dc, r + dr)
                        if mid in pin_holes or not (usage.get(mid, set()) - {net}):
                            continue          # hop only over a foreign trace
                    hc = hole_cost(q, net, pres, hard)
                    if hc is None:
                        continue
                    ncost = cost + hc + extra + (TURN_COST if d not in (-1, nd) else 0.0)
                    if ncost < best.get((q, nd), 1e18):
                        best[(q, nd)] = ncost
                        prev[(q, nd)] = (cur, d)
                        heapq.heappush(pq, (ncost, q, nd))
        return None

    def route_net(n, pres, hard):
        holes = [b.parts[ref].pins[pad] for ref, pad in n.pins]
        tree, remaining = {holes[0]}, list(dict.fromkeys(holes[1:]))
        segs, jumpers = [], []
        while remaining:
            remaining.sort(key=lambda h: min(abs(h[0] - t[0]) + abs(h[1] - t[1]) for t in tree))
            tgt = remaining.pop(0)
            if tgt in tree:
                continue
            path = dijkstra(n.name, tree, tgt, pres, hard)
            if path is None:
                near = min(tree, key=lambda t: abs(tgt[0] - t[0]) + abs(tgt[1] - t[1]))
                jumpers.append((near, tgt))
                tree.add(tgt)
                continue
            for h in path:
                if h not in pin_holes:
                    usage.setdefault(h, set()).add(n.name)
            segs.append(path)
            tree.update(path)
        return {"segs": segs, "jumpers": jumpers}

    def rip(name):
        for s in usage.values():
            s.discard(name)

    results, pres = {}, 0.5
    for it in range(ITERATIONS):
        for n in trace_nets:
            rip(n.name)
            results[n.name] = route_net(n, pres, hard=False)
        shared = [q for q, s in usage.items() if len(s) > 1]
        if not shared:
            break
        for q in shared:
            hist[q] = hist.get(q, 0.0) + 0.6
        pres *= 1.5
    # legalise: any net still sharing a hole is re-routed with hard blocking
    for n in trace_nets:
        if any(len(usage.get(h, set())) > 1 for p in results[n.name]["segs"] for h in p):
            rip(n.name)
            results[n.name] = route_net(n, pres, hard=True)
    # split hop steps out of the paths into explicit short wires
    for name, res in results.items():
        segs, hops = [], []
        for path in res["segs"]:
            cur = [path[0]]
            for a, c in zip(path, path[1:]):
                if abs(a[0] - c[0]) + abs(a[1] - c[1]) == 2:
                    if len(cur) > 1:
                        segs.append(cur)
                    hops.append((a, c))
                    cur = [c]
                else:
                    cur.append(c)
            if len(cur) > 1:
                segs.append(cur)
        res["segs"], res["hops"] = segs, hops
    occ = dict(pin_owner)
    for q, s in usage.items():
        for name in s:
            occ[q] = name if q not in occ or occ[q] == name else "CONFLICT"
    for n in b.nets:
        if n.kind == "wire":
            results[n.name] = {"segs": [], "hops": [], "jumpers": _wire_chain(b, n), "wire": True}
    return results, occ


def _wire_chain(b: Board, n: Net):
    """Minimum spanning tree (Manhattan length) over the pins of an insulated
    power wire net: each edge is one short wire soldered pin to pin."""
    holes = list(dict.fromkeys(b.parts[ref].pins[pad] for ref, pad in n.pins))
    tree, left, edges = {holes[0]}, set(holes[1:]), []
    while left:
        a, c = min(((t, h) for t in tree for h in left),
                   key=lambda e: abs(e[0][0] - e[1][0]) + abs(e[0][1] - e[1][1]))
        edges.append((a, c))
        tree.add(c)
        left.discard(c)
    return edges


POWER_LAST = {"GND", "+3V3_A", "+3V3_B", "+5V_LOGIC", "+5V", "+8V_STEER", "+5V_SERVO"}


def _hpwl(b, n):
    hs = [b.parts[ref].pins[pad] for ref, pad in n.pins]
    return (max(h[0] for h in hs) - min(h[0] for h in hs)) + (max(h[1] for h in hs) - min(h[1] for h in hs))


def verify(b: Board, results, occ) -> list[str]:
    """Union-find over every routed hole: each net must be one piece, and no
    hole may carry two nets."""
    msgs = []
    for n in b.nets:
        parent = {}

        def find(x):
            parent.setdefault(x, x)
            while parent[x] != x:
                parent[x] = parent[parent[x]]
                x = parent[x]
            return x

        def union(a, c):
            parent[find(a)] = find(c)

        res = results[n.name]
        for path in res["segs"]:
            for a, c in zip(path, path[1:]):
                if abs(a[0] - c[0]) + abs(a[1] - c[1]) != 1:
                    msgs.append(f"{n.name}: non-adjacent step {a}->{c}")
                if occ.get(a) != n.name or occ.get(c) != n.name:
                    msgs.append(f"{n.name}: path hole owned by another net")
                union(a, c)
        for a, c in res["jumpers"] + res.get("hops", []):
            union(a, c)
        holes = [b.parts[ref].pins[pad] for ref, pad in n.pins]
        roots = {find(h) for h in holes}
        if len(roots) != 1:
            msgs.append(f"{n.name}: NOT fully connected ({len(roots)} pieces)")
    return msgs


